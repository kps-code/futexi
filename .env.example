# Copy to .env for local development. Never commit .env.
# Every variable is validated at startup in src/server/env.ts.

# --- Required ---------------------------------------------------------------
# Database. Either a full DATABASE_URL (Neon in production, CI) or the DB_* parts (local service).
# DATABASE_URL wins when both are set. Create the database once with: npm run db:create
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=futexi
# Set DB_SSL=true for remote databases that require TLS.
DB_SSL=
# Payload auth secret. Generate: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-64-char-random-hex
# Salt for hashing visitor IPs in logs. Generate: openssl rand -hex 16
IP_HASH_SALT=change-me-to-a-32-char-random-hex
# Public site URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional, feature switches off when empty --------------------------------
# Vercel Blob for uploaded images (production). Local dev stores files on disk.
BLOB_READ_WRITE_TOKEN=
# Sentry error reporting. Empty = disabled.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Shared secret for /api/cron/* routes (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Log level: trace | debug | info | warn | error. Default info.
LOG_LEVEL=info
