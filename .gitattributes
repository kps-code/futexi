# Normalise line endings to LF in the repository for every text file,
# so the three of us on Windows, macOS or Linux never diff on CRLF.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
