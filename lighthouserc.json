{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/demos/booking",
        "http://localhost:3100/demo/booking",
        "http://localhost:3100/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3100/(?!demo/).*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["error", { "maxNumericValue": 350 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 190000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 90000 }],
            "errors-in-console": "error",
            "redirects": "error"
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/demo/.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["error", { "maxNumericValue": 400 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 190000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 130000 }],
            "errors-in-console": "error",
            "redirects": "error"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-reports"
    }
  }
}
